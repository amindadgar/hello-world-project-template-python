# Temporal Configuration
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=telegram-agent-queue

# MongoDB Configuration  
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=ai_agent_db
MONGODB_COLLECTION=telegram_requests

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Telegram Configuration
AUTHORIZED_USER_ID=265278326

# Streamlit Configuration
STREAMLIT_PASSWORD=admin123
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8501

# Optional: Sentiment Analysis
SENTIMENT_API_ENABLED=false
SENTIMENT_API_URL=

# Retry Configuration
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BACKOFF=10

# Logging
LOG_LEVEL=INFO

# Optional: TLS Configuration for Temporal Cloud
# TEMPORAL_TLS_CERT=
# TEMPORAL_TLS_KEY=
# TEMPORAL_TLS_CA=
